<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefWidth="400" prefHeight="300"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.NewTaskController">

    <Label layoutX="20" layoutY="20" text="Nueva tarea" style="-fx-font-size: 18;" />

    <Label layoutX="20" layoutY="70" text="Título:" />
    <TextField fx:id="titleField" layoutX="100" layoutY="65" prefWidth="250" />

    <Label layoutX="20" layoutY="115" text="Descripción:" />
    <TextArea fx:id="descriptionField" layoutX="100" layoutY="110" prefWidth="250" prefHeight="60" />

    <Label layoutX="20" layoutY="190" text="Fecha límite:" />
    <DatePicker fx:id="dueDatePicker" layoutX="100" layoutY="185" prefWidth="150" />

    <Button text="Guardar" layoutX="100" layoutY="240" prefWidth="100" onAction="#onSave" />
    <Button text="Cancelar" layoutX="220" layoutY="240" prefWidth="100" onAction="#onCancel" />

</AnchorPane>
