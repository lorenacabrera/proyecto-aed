<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<VBox spacing="10" alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.EditTaskController"
      prefWidth="400" prefHeight="500">

    <Label text="Editar Tarea" style="-fx-font-size: 20;" />

    <TextField fx:id="titleField" promptText="Título"/>

    <TextArea fx:id="descriptionField" promptText="Descripción" prefRowCount="4"/>

    <DatePicker fx:id="dueDatePicker" />

    <CheckBox fx:id="doneCheckBox" text="Completada" />

    <Label text="Categoría:" />
    <ComboBox fx:id="categoriaCombo" prefWidth="250" />

    <Label text="Usuario:" />
    <ComboBox fx:id="usuarioCombo" prefWidth="250" />

    <Button text="Guardar cambios" onAction="#onSave" prefWidth="160"/>
    <Button text="Cancelar" onAction="#onCancel" prefWidth="160"/>

</VBox>
